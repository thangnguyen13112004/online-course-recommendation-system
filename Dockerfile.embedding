FROM python:3.10-slim

WORKDIR /app

# Copy dependencies
COPY requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY embedding_service.py .

# Pre-download the model (optional but recommended so it doesn't download on first request/startup in production)
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-m3', device='cpu')"

# Expose port
EXPOSE 8000

# Run uvicorn with host 0.0.0.0
CMD ["uvicorn", "embedding_service:app", "--host", "0.0.0.0", "--port", "8000"]
